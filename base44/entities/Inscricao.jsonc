{
  "name": "Inscricao",
  "type": "object",
  "properties": {
    "modalidade": {
      "type": "string",
      "enum": [
        "Jiu-Jitsu",
        "Taekwondo",
        "M\u00fasica",
        "Dan\u00e7a"
      ],
      "enumColors": [
        "red",
        "orange",
        "purple",
        "pink"
      ],
      "description": "Modalidade da inscri\u00e7\u00e3o"
    },
    "nome_completo": {
      "type": "string",
      "description": "Nome completo do competidor"
    },
    "data_nascimento": {
      "type": "string",
      "format": "date",
      "description": "Data de nascimento (AAAA-MM-DD)"
    },
    "idade": {
      "type": "number",
      "description": "Idade calculada na data da inscri\u00e7\u00e3o"
    },
    "sexo": {
      "type": "string",
      "enum": [
        "Masculino",
        "Feminino"
      ],
      "enumColors": [
        "blue",
        "pink"
      ]
    },
    "peso_kg": {
      "type": "number",
      "description": "Peso em kg (apenas Jiu-Jitsu e Taekwondo)"
    },
    "faixa": {
      "type": "string",
      "description": "Faixa ou gradua\u00e7\u00e3o (apenas lutas)"
    },
    "categoria_idade": {
      "type": "string",
      "description": "Categoria et\u00e1ria calculada automaticamente"
    },
    "categoria_peso": {
      "type": "string",
      "description": "Divis\u00e3o de peso calculada automaticamente (apenas lutas)"
    },
    "equipe": {
      "type": "string",
      "description": "Equipe, academia ou escola"
    },
    "responsavel": {
      "type": "string",
      "description": "Professor ou respons\u00e1vel pela inscri\u00e7\u00e3o"
    },
    "telefone": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "description": "E-mail de contato do competidor"
    },
    "cidade": {
      "type": "string"
    },
    "observacoes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pendente",
        "confirmada",
        "cancelada"
      ],
      "enumColors": [
        "yellow",
        "green",
        "red"
      ],
      "default": "pendente"
    }
  },
  "required": [
    "modalidade",
    "nome_completo",
    "data_nascimento",
    "sexo"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}