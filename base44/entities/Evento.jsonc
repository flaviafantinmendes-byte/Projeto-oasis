{
  "name": "Evento",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "description": "Nome da competi\u00e7\u00e3o"
    },
    "slug": {
      "type": "string",
      "description": "Identificador para URLs"
    },
    "modalidade": {
      "type": "string",
      "description": "Modalidade esportiva"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do evento"
    },
    "local": {
      "type": "string",
      "description": "Local da competi\u00e7\u00e3o"
    },
    "cidade": {
      "type": "string",
      "description": "Cidade e estado"
    },
    "data_inicio": {
      "type": "string",
      "description": "Data de in\u00edcio (AAAA-MM-DD)"
    },
    "data_fim": {
      "type": "string",
      "description": "Data de t\u00e9rmino (AAAA-MM-DD)"
    },
    "status_inscricoes": {
      "type": "string",
      "enum": [
        "aberto",
        "breve",
        "encerrado",
        "finalizado"
      ],
      "enumColors": [
        "green",
        "yellow",
        "red",
        "gray"
      ],
      "default": "breve"
    },
    "atletas_inscritos": {
      "type": "number",
      "default": 0
    },
    "vagas": {
      "type": "number"
    },
    "imagem_url": {
      "type": "string"
    },
    "organizador": {
      "type": "string"
    },
    "categorias": {
      "type": "string",
      "description": "Categorias dispon\u00edveis"
    },
    "regulamento": {
      "type": "string"
    },
    "valor_inscricao_centavos": {
      "type": "number",
      "default": 0
    },
    "destaque": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "nome",
    "slug",
    "modalidade"
  ],
  "rls": {
    "read": {},
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}